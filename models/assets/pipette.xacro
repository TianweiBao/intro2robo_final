<?xml version="1.0" ?>
<robot name="pipette" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find pipette_description)/urdf/materials.xacro" />
<xacro:include filename="$(find pipette_description)/urdf/pipette.trans" />
<xacro:include filename="$(find pipette_description)/urdf/pipette.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.004767829783012695 -0.002879505402527167 0.055861254347200955" rpy="0 0 0"/>
    <mass value="0.6243910344717831"/>
    <inertia ixx="0.003029" iyy="0.003251" izz="0.000816" ixy="6.1e-05" iyz="0.000196" ixz="-0.000587"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://pipette_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://pipette_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

</robot>
